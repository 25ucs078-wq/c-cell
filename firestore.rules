rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is staff member with required role
    function isStaffMember(roleNeeded) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleNeeded;
    }

    // config documents
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Audit Logs collection
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // users collection: read/write restricted to owners and admins
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if request.auth.uid == userId && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // stages configuration rules
    match /admission_cycles/{cycleId}/stages/{stageId} {
      allow read: if true; // Publicly readable for timeline configuration
      allow write: if isAdmin();
    }

    // candidates collection rules
    match /admission_cycles/{cycleId}/candidates/{tempId} {
      // Candidates can view their own profile if bound; staff and admins can view
      allow read: if isAdmin() || 
                  (isAuthenticated() && request.auth.uid == resource.data.candidateUid);
      
      // Dynamic creation of onboarding session document
      allow create: if isAuthenticated() && 
                    request.resource.data.candidateUid == request.auth.uid &&
                    request.resource.data.completedStageIds == [] &&
                    request.resource.data.approved == false;

      // UID binding and progress updates
      allow update: if isAuthenticated() && (
        // Case A: Bind UID on first login (if pre-created with empty candidateUid or reset by admin)
        (resource.data.candidateUid == "" && request.resource.data.candidateUid == request.auth.uid) ||
        // Case B: Update completedStageIds / approved status
        (request.auth.uid == resource.data.candidateUid && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tempId', 'candidateUid'])) &&
         // Guard: If completedStageIds grows, enforce batch creation and strict sequential ordering
         (request.resource.data.completedStageIds.size() == resource.data.completedStageIds.size() ||
          (request.resource.data.completedStageIds.size() == resource.data.completedStageIds.size() + 1 &&
           // 1. Ensure log is created in the same transaction
           existsAfter(/databases/$(database)/documents/admission_cycles/$(cycleId)/candidates/$(tempId)/stage_logs/$(request.resource.data.completedStageIds[request.resource.data.completedStageIds.size() - 1])) &&
           // 2. Ensure added stage's order is exactly equal to current completed size + 1 (strict sequential order)
           get(/databases/$(database)/documents/admission_cycles/$(cycleId)/stages/$(request.resource.data.completedStageIds[request.resource.data.completedStageIds.size() - 1])).data.stageOrder == resource.data.completedStageIds.size() + 1))
        )
      );

      // stage_logs subcollection rules
      match /stage_logs/{stageId} {
        // Read: Candidates can view their own stage logs
        allow read: if isAdmin() || 
                    (isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/admission_cycles/$(cycleId)/candidates/$(tempId)).data.candidateUid);
        
        // Write: Create log ONLY IF entering the correct passcode hash matching the stage's hash!
        allow create: if isAuthenticated() && 
                      request.auth.uid == get(/databases/$(database)/documents/admission_cycles/$(cycleId)/candidates/$(tempId)).data.candidateUid &&
                      request.resource.data.passcodeHash == get(/databases/$(database)/documents/admission_cycles/$(cycleId)/stages/$(stageId)).data.bypassCodeHash;
        
        // Audit logs are read-only: updates/deletes are strictly forbidden
        allow update, delete: if false;
      }
    }

    // Future modules rules
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
